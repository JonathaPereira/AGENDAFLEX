{
  "name": "agendaflex",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm --filter @agendaflex/api dev\" \"pnpm --filter @agendaflex/web dev\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "pnpm --filter @agendaflex/database generate",
    "db:migrate": "pnpm --filter @agendaflex/database migrate",
    "db:setup-sql": "node database/scripts/export-supabase-setup.mjs",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "mobile:prepare": "pnpm --filter @agendaflex/web mobile:prepare",
    "mobile:prepare:connected": "pnpm --filter @agendaflex/web mobile:prepare:connected",
    "mobile:android": "pnpm --filter @agendaflex/web mobile:android",
    "mobile:ios": "pnpm --filter @agendaflex/web mobile:ios",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "test:db": "pnpm --filter @agendaflex/database test",
    "test:e2e:billing": "playwright test --config playwright.billing.config.ts"
  },
  "devDependencies": {
    "@agendaflex/shared": "workspace:*",
    "@eslint/js": "^9.25.1",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.15.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.25.1",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "postgres": "^3.4.9",
    "prettier": "^3.5.3",
    "tsx": "^4.23.15",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.31.0",
    "vitest": "^3.1.2"
  },
  "type": "module"
}
