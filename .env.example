# Copie para .env na raiz. Nenhuma conexão externa é necessária para dev/health.
HOST=127.0.0.1
PORT=3001
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3001
# Login: URL e chave PÚBLICA publishable/anon do MESMO projeto Supabase.
# Funciona com projeto de desenvolvimento na nuvem ou Supabase local.
# Nunca use chave sb_secret_ ou service_role, nem senha do banco nestes campos.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Apenas backend/ferramentas de migração; nunca prefixar com VITE_.
DATABASE_URL=

# API HTTPS publicada para o build nativo conectado; localhost não funciona no celular.
VITE_MOBILE_API_URL=
